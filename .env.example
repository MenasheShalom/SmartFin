# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=smartfin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartfin

# --- Login ---
# The username and password are created in the web app the first time you open it.
# true when the app is served over HTTPS (e.g. behind "tailscale serve")
COOKIE_SECURE=false

# --- Scraper -> backend ---
# Shared secret between the backend and the scraper (the ingest endpoint, and the scraper's API
# for managing bank logins). Generate one with:
#   openssl rand -hex 32
INGEST_TOKEN=change-me

# --- Scraper ---
# Bank and card logins are added in the web app (הגדרות › חשבונות וסנכרון). The scraper keeps them
# encrypted in scraper/config/accounts.json.enc.
# Nightly scrape time, Israel time, 24-hour HH:MM
SCRAPE_TIME=03:00
# How many days back each scrape fetches; overlapping days are de-duplicated
SCRAPER_DAYS_BACK=30
# How far back the first sync of a newly added login goes
SCRAPER_FIRST_DAYS_BACK=365
# Key for accounts.json.enc. Optional: when empty, the scraper generates one and keeps it in its
# own Docker volume (scraper-keys), apart from the config folder. Set it (openssl rand -base64 32)
# to keep the key yourself. Either way, losing the key means entering the logins again.
SCRAPER_ACCOUNTS_KEY=

# --- Network ---
# 0.0.0.0 = reachable from your home network; 127.0.0.1 = this machine only
BIND_ADDRESS=0.0.0.0
PORT=8000

# --- Backups (./backups) ---
BACKUP_KEEP_DAYS=14

# --- Alerts (checked after every sync; leave a threshold empty to turn that check off) ---
# Alert when a budget reaches these percentages
BUDGET_ALERT_LEVELS=80,100
# Alert when a bank account balance drops below this (ILS)
LOW_BALANCE_THRESHOLD=
# Alert on any single new expense at or above this (ILS)
LARGE_TRANSACTION_THRESHOLD=

# Telegram: create a bot with @BotFather for the token; message the bot, then open
# https://api.telegram.org/bot<token>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (e.g. Gmail: smtp.gmail.com, port 587, with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
