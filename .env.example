# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=smartfin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartfin

# --- Scraper (Phase 1: one account, run manually) ---
# One of: hapoalim, leumi, mizrahi, discount, mercantile, otsarHahayal, max,
# visaCal, isracard, amex, union, beinleumi, massad, yahav, beyahadBishvilha,
# behatsdaa, pagi
SCRAPER_COMPANY=leumi
# JSON object with the login fields that company needs, e.g.
#   leumi/max/visaCal: {"username": "...", "password": "..."}
#   hapoalim:          {"userCode": "...", "password": "..."}
#   isracard/amex:     {"id": "...", "card6Digits": "...", "password": "..."}
#   discount:          {"id": "...", "password": "...", "num": "..."}
# Wrap in single quotes if a password contains $ or #.
SCRAPER_CREDENTIALS='{"username": "", "password": ""}'
# How far back to fetch on a manual run
SCRAPER_DAYS_BACK=30
